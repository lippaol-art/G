# Copy to .env on the VPS and fill in. .env is gitignored — NEVER commit it.

# --- Claude API (LLM day-analysis) ---
ANTHROPIC_API_KEY=sk-ant-...
PROPBOT_LLM_MODEL=claude-opus-4-8

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-...
# your own chat id(s), comma-separated; the bot ignores everyone else
TELEGRAM_ALLOWED_CHAT_IDS=

# --- MetaTrader 5 (the terminal must be logged in to the prop account) ---
# Credentials are entered in the MT5 terminal itself, not here. The Python
# bridge attaches to the running terminal. Keep the terminal's saved login
# on the VPS only.
